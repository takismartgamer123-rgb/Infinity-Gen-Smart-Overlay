# Required for remote administration. Generate a long random value.
ADMIN_TOKEN=replace-with-a-long-random-secret

# HTTP server
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=./data/infinity-ultra.sqlite
LOBBY_SECONDS=20
GAME_MAX_SECONDS=300

# YouTube Live Chat (optional until a real live-stream test)
YOUTUBE_VIDEO_ID=
# Comma-separated YouTube channel IDs allowed to use .start and .stop
ADMIN_CHANNEL_IDS=

# Streaming is disabled unless explicitly enabled.
ENABLE_PUBLISHER=false
# Select rtmp (default) or hls. HLS sends media segments to YouTube directly.
PUBLISH_PROTOCOL=rtmp
# RTMP(S) destination, used only when PUBLISH_PROTOCOL=rtmp.
PUBLISH_URL=
# YouTube Studio HLS stream key, used only when PUBLISH_PROTOCOL=hls.
# Never commit a real key. Configure it as a deployment secret.
YOUTUBE_HLS_STREAM_KEY=
FFMPEG_PATH=ffmpeg
FFMPEG_BITRATE=1800k
